# Advance Billing System Environment Configuration
# Copy this file to .env and replace placeholder values before deploying to production.

DJANGO_SECRET_KEY=replace-with-a-long-random-50-plus-char-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# Database (Leave empty for local SQLite; set PostgreSQL URL for live business production)
# Example: DATABASE_URL=postgresql://billing_user:StrongPass123@127.0.0.1:5432/advance_billing?sslmode=prefer
DATABASE_URL=
DJANGO_DB_CONN_MAX_AGE=600

# Production HTTPS flags (applied automatically when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Email Configuration
# When EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are set, SMTP is auto-enabled.
# For Gmail: enable 2-Step Verification and generate an App Password.
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Advance Billing System <no-reply@advancebilling.local>
